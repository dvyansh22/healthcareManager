# ========================================================
# api-core (ASP.NET Core) - appsettings.json equivalent
# ========================================================
# ConnectionStrings:Default
DB_CONNECTION_STRING=Host=your-db-host;Database=healthcare;Username=postgres;Password=your-password

# Jwt
JWT_SECRET=your_super_secret_32_character_jwt_key
JWT_ISSUER=healthcare_app
JWT_EXPIRY_MINUTES=120

# Shared Secret for Service-to-Service auth
SERVICE_TOKEN=your_shared_internal_secret_token

# AiService
AI_SERVICE_BASE_URL=https://your-ai-service-url.onrender.com/

# Google Calendar (Optional)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REFRESH_TOKEN=1//your-refresh-token

# Frontend Origin for CORS
FRONTEND_ORIGIN=https://your-nextjs-frontend-url.vercel.app


# ========================================================
# ai-service (Django) - .env
# ========================================================
DJANGO_SECRET_KEY=your_django_secret_key
DEBUG=False

# Database (Same as above, broken down)
DB_NAME=healthcare
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=your-db-host
DB_PORT=5432

# Shared Secret (Must match api-core's SERVICE_TOKEN)
SERVICE_TOKEN=your_shared_internal_secret_token

# Gemini LLM
GEMINI_API_KEY=your_gemini_api_key

# Email Service
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key


# ========================================================
# web (Next.js) - .env.local
# ========================================================
NEXT_PUBLIC_API_BASE_URL=https://your-api-core-url.onrender.com
